# 生成的音频不入库 —— 有 translations/ + baseline/ + scripts/ 就能完整复现。
# 成品打成 zip 挂 GitHub Releases，见 packaging/build_release.sh。
output/
dist/

# baseline/ 是生成结果的必要输入，必须入库，别加通配的 *.wav 忽略规则

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 翻译中间态 —— 断点续跑的临时文件，最终结果才提交
translations/*.partial.csv
translations/*.tmp.csv

# 日志
*.log
logs/
# Windows 验收时收集的 CrewChief 控制台日志 —— 里面有本机用户名和绝对路径。
# 结论已经写进 docs/踩坑与经验总结.md §8，原始日志没有留档价值。
log/

# 系统
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp

# Claude Code 的本地会话配置 —— 里面是本机绝对路径，不该进库。
# 作用是让从本库启动的会话自动能读写另外两个仓库（见 CLAUDE.md「三仓库布局」）。
.claude/settings.local.json
CLAUDE.md
