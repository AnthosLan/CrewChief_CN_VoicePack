# 生成产物 —— 可由 translations/ + baseline/ 完整复现，不入库
output/
*.wav
*.mp3
*.zip

# 例外：baseline 是生成结果的必要输入，必须入库才能复现
!baseline/**/*.wav

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 翻译中间态 —— 断点续跑的临时文件，最终结果才提交
translations/*.partial.csv
translations/*.tmp.csv

# 日志
*.log
logs/

# 系统
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
